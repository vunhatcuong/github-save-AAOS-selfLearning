<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.My_first_AAOS_v1" parent="Theme.AppCompat.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/surface</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/primary_action</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background</item>
        <!-- Background color -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Text styles -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Custom Button Style -->
    <style name="VehicleLab.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/surface_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="VehicleLab.Button.Primary" parent="VehicleLab.Button">
        <item name="android:background">@color/primary_action</item>
        <item name="android:textColor">@color/primary_action_text</item>
    </style>

    <style name="VehicleLab.Text.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VehicleLab.Text.PropertyLabel" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="VehicleLab.Text.PropertyValue" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
